{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Easy-writing",
  "version": "0.3.5",
  "identifier": "com.easywriting.desktop",
  "build": {
    "beforeDevCommand": "pnpm build:assets",
    "devUrl": "http://127.0.0.1:8080",
    "beforeBuildCommand": "pnpm build:assets && trunk build --config frontend/Trunk.toml --release",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Easy-writing · 小说工作台",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/images/**"]
      },
      "csp": "default-src 'self' tauri: blob: data: asset:; img-src 'self' tauri: blob: data: asset: http://asset.localhost https://*; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost tauri: http://localhost:* http://127.0.0.1:* https://*;"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
