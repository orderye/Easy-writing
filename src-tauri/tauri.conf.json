{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Easy-writing",
  "version": "0.1.0",
  "identifier": "com.easywriting.app",
  "build": {
    "beforeDevCommand": "pnpm build:bridge",
    "devUrl": "http://127.0.0.1:8080",
    "beforeBuildCommand": "pnpm build:bridge && trunk build --config frontend/Trunk.toml index.html",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Easy-writing · 小说工作台",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/images/**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
