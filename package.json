{
  "name": "easy-writing",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:tiptap": "esbuild js/src/tiptap-bridge.js --bundle --minify --format=iife --global-name=TiptapBridge --outfile=frontend/public/tiptap-bridge.bundle.js",
    "build:graph": "esbuild js/src/graph-bridge.js --bundle --minify --format=iife --global-name=CharacterGraphBridge --outfile=frontend/public/graph-bridge.bundle.js",
    "build:bridge": "pnpm build:tiptap && pnpm build:graph",
    "build:css": "tailwindcss -i frontend/styles/main.css -o frontend/public/styles.css --minify",
    "build:assets": "pnpm build:bridge && pnpm build:css",
    "dev:frontend": "pnpm build:assets && trunk serve --open=false frontend/index.html",
    "tauri": "tauri",
    "dev": "pnpm build:assets && tauri dev",
    "build": "pnpm build:assets && tauri build",
    "test:frontend": "node --test tests/frontend/*.test.js",
    "test:backend": "cargo test -p easy-writing-core -p easy-writing-frontend",
    "test": "pnpm test:frontend && pnpm test:backend"
  },
  "dependencies": {
    "@tiptap/core": "^2.10.4",
    "@tiptap/extension-character-count": "^2.10.4",
    "@tiptap/extension-color": "^2.10.4",
    "@tiptap/extension-image": "^2.10.4",
    "@tiptap/extension-placeholder": "^2.10.4",
    "@tiptap/extension-text-align": "^2.10.4",
    "@tiptap/extension-text-style": "^2.10.4",
    "@tiptap/extension-underline": "^2.10.4",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/starter-kit": "^2.10.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.2",
    "esbuild": "^0.24.2",
    "tailwindcss": "^3.4.19"
  }
}
